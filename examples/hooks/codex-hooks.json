{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)\"/.agents/hooks/before-edit.mjs",
            "timeout": 30,
            "statusMessage": "核对是否已读模块 CONVENTIONS…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)\"/.agents/hooks/after-edit.mjs",
            "timeout": 60,
            "statusMessage": "格式化并检查刚编辑的文件…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)\"/.agents/hooks/verify-changes.sh",
            "timeout": 900,
            "statusMessage": "运行改动模块的检查与测试可信度检查…"
          }
        ]
      }
    ]
  }
}
